# Copie para .env (ou cadastre estas variáveis no painel da hospedagem). NUNCA publique o .env.
# Fonte principal de preços e links reais (https://serpapi.com, tem plano gratuito limitado):
SERPAPI_KEY=
# Mercado Livre (https://developers.mercadolivre.com.br, crie um app). O ML pode negar a busca mesmo com app:
ML_APP_ID=
ML_CLIENT_SECRET=
# Opcional: IA só para entender o que foi digitado (nunca gera preços):
ANTHROPIC_API_KEY=
# Ajustes (opcionais):
CACHE_TTL_MIN=60
MAX_PRODUCTS_DETAIL=3
